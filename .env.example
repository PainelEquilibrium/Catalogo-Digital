# Copie para .env (já no .gitignore). Sem valores secretos neste arquivo.
# Projeto Supabase de DESENVOLVIMENTO apenas.

# Prisma — pooler (Client) e sessão (migrate / studio)
# Painel: Project Settings > Database > Connection string (URI)
# DATABASE_URL: Transaction pooler :6543 + ?pgbouncer=true&sslmode=require
# DIRECT_URL: Session pooler :5432 + ?sslmode=require (o host db.*.supabase.co:5432
#   costuma falhar em IPv6; prefira o pooler de sessão).
# Se a senha tiver # @ / ?, use percent-encoding (%23 para #).
DATABASE_URL=
DIRECT_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp — só dígitos, fallback. O valor efetivo virá do banco.
WHATSAPP_NUMBER=

# GTM — vazio = sem container
NEXT_PUBLIC_GTM_ID=

# Override de flags: {"algumaFlag":true}
FLAGS_JSON=

# Supabase Auth (admin) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credenciais do usuário owner no seed (prisma/seed.ts)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Só prisma/seed.ts. Nunca NEXT_PUBLIC_. Nunca importar no src/.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da tarefa diária /api/cron/limpeza. A Vercel envia como Bearer. Vazio = rota responde 401.
CRON_SECRET=
