# ============================================================
# Catálogo Digital — Variáveis de Ambiente
# Copie para .env.local e preencha com os dados do projeto
# Supabase DESTE cliente (cada branch cliente tem o seu).
# ============================================================

# --- Supabase (obrigatório) ---
# URL do projeto Supabase do cliente
# Painel: Project Settings > Data > Project URL
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PASSWORD="Zf1gAlHGgDA4!AvtLP0yAugCnEjWjtTE"

# Chave anônima (pública, segura para o browser — RLS protege os dados)
# Painel: Project Settings > Data > API Keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key (NUNCA expor no client; só server-side)
# Bypassa RLS — usar apenas em rotas/actions validadas
# Painel: Project Settings > Data > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (fallback de deploy) ---
# Número da loja no formato internacional, só dígitos: 5511999998888
# O valor efetivo vem do banco (store_settings); este é fallback
WHATSAPP_NUMBER=

# --- Site ---
# URL pública do deploy deste cliente (usada em og:url e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Flags (opcional — override de feature flags por ambiente) ---
# FLAGS_JSON={"clienteAnaFeature":true}
FLAGS_JSON=
